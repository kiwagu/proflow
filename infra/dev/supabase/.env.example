############
# Secrets
#
# YOU MUST CHANGE ALL THE DEFAULT VALUES BELOW BEFORE STARTING
# THE CONTAINERS FOR THE FIRST TIME!
#
# Documentation:
# https://supabase.com/docs/guides/self-hosting/docker#configuring-and-securing-supabase
#
# To generate secrets and API keys:
# sh ./utils/generate-keys.sh
#
############

# Postgres
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# Legacy symmetric HS256 key
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
# Legacy API keys (HS256-signed JWTs)
ANON_KEY=some-anon-key
SERVICE_ROLE_KEY=some-service-role-key

# Asymmetric key pair (ES256) and opaque API keys
#
# Documentation:
# https://supabase.com/docs/guides/self-hosting/self-hosted-auth-keys
#
# To generate:
# sh ./utils/add-new-auth-keys.sh
#
# Opaque API key for client-side use (anon role).
SUPABASE_PUBLISHABLE_KEY=
# Opaque API key for server-side use (service_role). Never expose in client code.
SUPABASE_SECRET_KEY=
# JSON array of signing JWKs (EC private + legacy symmetric).
# Used by Auth.
JWT_KEYS=
# JWKS for token verification (EC public + legacy symmetric).
# Used by PostgREST, Realtime, Storage to verify tokens.
JWT_JWKS=

# Access to Dashboard
DASHBOARD_USERNAME=your-dashboard-username
DASHBOARD_PASSWORD=your-dashboard-password

# Used by Realtime and Supavisor
SECRET_KEY_BASE=some-secret-key-base

# Used by Supavisor
VAULT_ENC_KEY=some-vault-enc-key

# Used by Studio to access Postgres via postgres-meta
PG_META_CRYPTO_KEY=your-encryption-key-32-chars-min

# Analytics - API tokens for log ingestion/querying, and for management.
# Only used by the optional logs overlay (docker-compose.logs.yml). Generated by generate-keys.sh.
LOGFLARE_PUBLIC_ACCESS_TOKEN=your-super-secret-and-long-logflare-key-public
LOGFLARE_PRIVATE_ACCESS_TOKEN=your-super-secret-and-long-logflare-key-private

# Access to Storage via S3 protocol endpoint (see below)
S3_PROTOCOL_ACCESS_KEY_ID=some-s3-protocol-access-key-id
S3_PROTOCOL_ACCESS_KEY_SECRET=some-s3-protocol-access-key-secret


############
# URLs - Configure hostnames below to reflect your actual domain name
############

# Access to Dashboard and REST API
SUPABASE_PUBLIC_URL=https://api.proflow.local

# Full external URL of the Auth service, used to construct OAuth callbacks,
# SAML endpoints, and email links
API_EXTERNAL_URL=https://api.proflow.local

# See also the Auth section below for Site URL and Redirect URLs configuration


############
# Database - Postgres configuration
############

# Using default user (postgres)
POSTGRES_HOST=db
POSTGRES_DB=postgres

# Default configuration includes Supavisor exposing POSTGRES_PORT
# Postgres uses POSTGRES_PORT inside the container
# Documentation:
# https://supabase.com/docs/guides/self-hosting/docker#accessing-postgres-through-supavisor
POSTGRES_PORT=5432

# Host loopback port -> Postgres db:5432 (see dev/docker-compose.dev.yml). Makefile uses postgres + POSTGRES_PASSWORD on this port (Supabase CLI runs migrations as postgres). db-push runs docker exec supabase_admin to assign public.profiles to postgres if needed. Empty = pooler only.
POSTGRES_DIRECT_PORT=54322


############
# Supavisor - Database pooler
############
#
# Keep volumes/pooler/pooler.exs aligned with upstream Supabase docker when you pull updates;
# document session-mode URLs and POOLER_TENANT_ID usage here (and Makefile help), not in pooler.exs.

# Supavisor exposes POSTGRES_PORT and POOLER_PROXY_PORT_TRANSACTION,
# POSTGRES_PORT is used for session mode pooling
#
# Port to use for transaction mode pooling connections
POOLER_PROXY_PORT_TRANSACTION=6543

# Maximum number of PostgreSQL connections Supavisor opens per pool
POOLER_DEFAULT_POOL_SIZE=20

# Maximum number of client connections Supavisor accepts per pool
POOLER_MAX_CLIENT_CONN=100

# Unique Supavisor tenant identifier
# Documentation:
# https://supabase.com/docs/guides/self-hosting/docker#accessing-postgres
#
# Session-mode clients (host POSTGRES_PORT -> Supavisor) must use DB user postgres.${POOLER_TENANT_ID}
# (same POSTGRES_PASSWORD). Repo Makefile db-push/db-diff/db-pull builds that URL from this value.
POOLER_TENANT_ID=your-tenant-id

# Pool size for internal metadata storage used by Supavisor
# This is separate from client connections and used only by Supavisor itself
POOLER_DB_POOL_SIZE=5


############
# Studio - Configuration for the Dashboard
############

STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project

# Add your OpenAI API key to enable AI Assistant
OPENAI_API_KEY=sk-proj-xxxxxxxx


############
# Auth - Configuration for the authentication server
############

## General settings

# Equivalent to "Site URL" and "Redirect URLs" platform configuration options
# Documentation: https://supabase.com/docs/guides/auth/redirect-urls
SITE_URL=https://proflow.local/platform
# Comma-separated glob patterns (no spaces). GoTrue rejects unknown redirect_to and falls back to SITE_URL
# — without /platform/** here, space-invite magic links land on /platform with no ?code= (broken flow).
# Trim hosts you do not use. Restart the auth (gotrue) container after changes.
ADDITIONAL_REDIRECT_URLS=https://proflow.local/platform/**,http://proflow.local/platform/**,http://127.0.0.1:3000/platform/**,http://localhost:3000/platform/**,https://proflow.local/author/**,http://proflow.local/author/**,http://127.0.0.1:3000/author/**,http://localhost:3000/author/**
MAILER_EXTERNAL_HOSTS=proflow.local,api.proflow.local,localhost,127.0.0.1

JWT_EXPIRY=3600
DISABLE_SIGNUP=false

## Mailer Config
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

## Email auth
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@example.com
# Dev mail goes to the Maildev container (infra/dev/docker-compose.yml). Auth and Maildev
# share the `proflow` Docker network, so reach it by service name on its INTERNAL port
# (1025), not the host-mapped 2500 (that port is bound to 127.0.0.1 and is unreachable from
# the Docker bridge — GoTrue would fail with "dial ... 2500: connection refused").
SMTP_HOST=maildev
SMTP_PORT=1025
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=fake_sender
ENABLE_ANONYMOUS_USERS=false

## Phone auth
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true

## OAuth / Social login providers

# Uncomment and fill in the providers you want to enable.
# You must ALSO uncomment the matching GOTRUE_EXTERNAL_* lines in docker-compose.yml.
# Documentation: https://supabase.com/docs/guides/self-hosting/self-hosted-oauth
# GOOGLE_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_SECRET=

# GITHUB_ENABLED=false
# GITHUB_CLIENT_ID=
# GITHUB_SECRET=

# AZURE_ENABLED=false
# AZURE_CLIENT_ID=
# AZURE_SECRET=

# Phone / SMS provider configuration
# Uncomment to configure SMS delivery for phone auth and phone MFA.
# You must ALSO uncomment the matching GOTRUE_SMS_* lines in docker-compose.yml.
# Documentation: https://supabase.com/docs/guides/self-hosting/self-hosted-phone-mfa
# SMS_PROVIDER=twilio
# SMS_OTP_EXP=60
# SMS_OTP_LENGTH=6
# SMS_MAX_FREQUENCY=60s
# SMS_TEMPLATE=Your code is {{ .Code }}

# SMS_TWILIO_ACCOUNT_SID=
# SMS_TWILIO_AUTH_TOKEN=
# SMS_TWILIO_MESSAGE_SERVICE_SID=

# Optional custom SMS hook for Auth. Point this at your pg-function or external webhook target.
# GOTRUE_HOOK_SEND_SMS_URI=pg-functions://postgres/public/send_sms
# GOTRUE_HOOK_SEND_SMS_SECRETS=v1,whsec_your_base64_secret_here

# Test OTP: map phone numbers to fixed OTP codes for development
# Format: phone1:code1,phone2:code2
# SMS_TEST_OTP=

# Multi-factor authentication (MFA)
# Uncomment to change MFA defaults.
# You must ALSO uncomment the matching GOTRUE_MFA_* lines in docker-compose.yml.

# App Authenticator (TOTP) - enabled by default
# MFA_TOTP_ENROLL_ENABLED=true
# MFA_TOTP_VERIFY_ENABLED=true

# Phone MFA - disabled by default (opt-in)
# MFA_PHONE_ENROLL_ENABLED=false
# MFA_PHONE_VERIFY_ENABLED=false

## Maximum MFA factors a user can enroll
# MFA_MAX_ENROLLED_FACTORS=10


############
# Storage - Configuration for Storage
############

# Check the S3_PROTOCOL_ACCESS_KEY_ID/SECRET above, and
# refer to the documentation at:
# https://supabase.com/docs/guides/self-hosting/self-hosted-s3
# to learn how to configure the S3 protocol endpoint

# S3 bucket when using S3 backend, directory name when using 'file'
GLOBAL_S3_BUCKET=stub

# Used for S3 protocol endpoint configuration
REGION=stub

# Used by MinIO when added via:
# docker compose -f docker-compose.yml -f docker-compose.s3.yml up -d
MINIO_ROOT_USER=supa-storage
MINIO_ROOT_PASSWORD=secret1234

# Equivalent to project_ref as described here:
# https://supabase.com/docs/guides/storage/s3/authentication#session-token
STORAGE_TENANT_ID=stub


############
# Functions - Configuration for Edge functions
############

# Documentation:
# https://supabase.com/docs/guides/self-hosting/self-hosted-functions

# NOTE: VERIFY_JWT applies to all functions
FUNCTIONS_VERIFY_JWT=false

# Edge logging (`@workspace/logger` / pino): LOG_LEVEL=trace|debug|info|warn|error|fatal|silent; when unset, default is info unless NODE_ENV=production (then warn).
# LOG_FORMAT=json → one JSON object per line to stdout; empty → Go-style key=value lines (time=… level=… requestId=… msg=…).
# LOG_LEVEL=info
# LOG_FORMAT=

# GoTrue HTTP(S) hook URIs: plain http:// is only allowed for localhost / 127.0.0.1 / ::1 (and host.docker.internal in newer Auth).
# http://kong:8000/... makes Auth exit with: only localhost, 127.0.0.1, and ::1 are supported with http — use https:// below.
#
# GoTrue send_email hook -> Edge Function `email_sender` -> notifications-service
# Standard Webhooks symmetric secret (v1,whsec_ + base64):
#   openssl rand -base64 32 | tr -d '\n' | sed 's/^/v1,whsec_/'
# Opaque hex tokens (Bearer / internal headers):
#   openssl rand -hex 32
# Styled auth emails (GoTrue → Edge email_sender → services/notifications → React Email).
# OFF by default → GoTrue sends its plain built-in templates. To enable, uncomment all
# three here + the NOTIFICATIONS_* pair below, run services/notifications, and recreate
# auth+functions. Full walkthrough: README.md "Styled transactional email" step.
# GOTRUE_HOOK_SEND_EMAIL_ENABLED=true
# GOTRUE_HOOK_SEND_EMAIL_URI=https://kong:8443/functions/v1/email_sender
# GOTRUE_HOOK_SEND_EMAIL_SECRETS=v1,whsec_your_base64_secret_here

# Identity lifecycle: Auth -> Edge `identity_lifecycle_fanout` -> NATS JetStream only.
# Postgres triggers use internal secret; `make db-push` runs db-sync-identity-secret (Makefile DEV_IDENTITY_INTERNAL_INGEST_SECRET must match compose).
# NATS runs in `infra/dev/docker-compose.yml` (same `proflow` project). Edge volumes: `packages/domain-events/dist` → `identity_lifecycle_fanout/domain_events_dist`; `packages/logger/dist` → `logger_dist`. Build: `bun run build --filter=@workspace/domain-events` and `bun run build --filter=@workspace/logger`. Override if needed:
# NATS_URL=nats://nats:4222
# IDENTITY_NATS_STREAM=IDENTITY_LIFECYCLE
# apps/author: set NATS_URL=nats://127.0.0.1:4222 (host port); `bun run dev` runs Next + JetStream consumer (or `bun run identity:jetstream` for worker only).
# Internal URL where the Edge Function forwards the verified payload to the host
# notifications service (:3010). host.docker.internal resolves to the Docker host
# gateway (functions has the host-gateway extra_hosts in dev/docker-compose.dev.yml).
# Prefer this over a hardcoded bridge IP (172.x.0.1), which varies per network.
# NOTIFICATIONS_SERVICE_URL=http://host.docker.internal:3010
# Bearer token shared with notifications-service (`NOTIFICATIONS_INTERNAL_TOKEN`).
# Must match NOTIFICATIONS_INTERNAL_TOKEN in services/notifications/.env.
# NOTIFICATIONS_INTERNAL_TOKEN=dev-notifications-token
# Standard Webhooks secret shared by GoTrue and `identity_lifecycle_fanout` verification.
GOTRUE_HOOK_AFTER_USER_CREATED_SECRETS=v1,whsec_your_base64_secret_here 
# Path segment for verifyOtp links (platform app): /platform/auth/confirm
# Used by notifications-service (not by Edge runtime directly).
# AUTH_EMAIL_CONFIRM_PATH=/platform/auth/confirm


############
# API - Configuration for PostgREST
############

# Postgres schemas exposed via the REST API
# `kb` exposes the KB application-data node satellites (RLS-mirrored to the node).
PGRST_DB_SCHEMAS=public,storage,graphql_public,kb

# Max number of rows returned by a request
PGRST_DB_MAX_ROWS=1000

# Extra schemas added to the search_path of every request
PGRST_DB_EXTRA_SEARCH_PATH=public


############
# Logs and Analytics (optional — enabled only via docker-compose.logs.yml overlay)
############

# Docker socket location - this value will differ depending on your OS
DOCKER_SOCKET_LOCATION=/var/run/docker.sock

# Google Cloud Project details (Logflare BigQuery backend; optional)
GOOGLE_PROJECT_ID=GOOGLE_PROJECT_ID
GOOGLE_PROJECT_NUMBER=GOOGLE_PROJECT_NUMBER


############
# API gateway
############

# Kong configuration variables
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# Used internally by the API gateway - DO NOT use in any client or server code.
# Pre-signed ES256 JWT "API key" for anon role.
ANON_KEY_ASYMMETRIC=
# Pre-signed ES256 JWT "API key" for service_role.
SERVICE_ROLE_KEY_ASYMMETRIC=


############
# imgproxy
############

# Enable webp support
IMGPROXY_AUTO_WEBP=true


############
# TLS Proxy - Optional Caddy or Nginx reverse proxy with Let's Encrypt
############

# Documentation:
# https://supabase.com/docs/guides/self-hosting/self-hosted-proxy-https

# Usage:
# docker compose -f docker-compose.yml -f docker-compose.caddy.yml up -d
# docker compose -f docker-compose.yml -f docker-compose.nginx.yml up -d

# Domain name for the proxy (must point to your server)
PROXY_DOMAIN=your-domain.example.com

# Email for Let's Encrypt certificate notifications (nginx only, Caddy uses PROXY_DOMAIN).
# This should be a valid email, not a placehoder (otherwise Certbot may fail to start).
CERTBOT_EMAIL=admin@example.com
