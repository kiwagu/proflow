MONGO_PASSWORD=your-mongo-password
# Port on the host for reverse proxy (Bun/Next dev). Default matches apps/web gateway `next dev -p 3000`.
PROFLOW_DEV_APP_PORT=3000
# Kong upstream used by nginx for https://api.proflow.local
PROFLOW_SUPABASE_UPSTREAM_HOST=host.docker.internal
PROFLOW_SUPABASE_UPSTREAM_PORT=8000
