# Included in http {} — local edge: redirect HTTP, proxy HTTPS to dev on host.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Browser Origin → Access-Control-Allow-Origin (UI on proflow.local or localhost:* dev servers)
map $http_origin $supabase_cors_origin {
    "~^https://proflow\.local$" $http_origin;
    "~^http://proflow\.local$" $http_origin;
    "~^http://localhost:[0-9]+$" $http_origin;
    "~^https://localhost:[0-9]+$" $http_origin;
    default "https://proflow.local";
}

# Docker embedded DNS — required when proxy_pass uses a variable (runtime resolve for host.docker.internal)
resolver 127.0.0.11 valid=10s ipv6=off;

# How many requests one kept-alive connection may carry before the edge
# recycles it. The built-in default is 1000 and, since nginx 1.19.7, it applies
# to HTTP/2 too: at request 1001 nginx sends GOAWAY and closes.
#
# That default is sized for ordinary page traffic. It is far too small in front
# of a module-per-request dev server: the SPA's unbundled module graph is ~1150
# requests for a SINGLE page load (measured from a Playwright trace), so the
# recycle boundary lands INSIDE a page load rather than between them. The
# browser is mid-way through fetching the module graph when the connection goes;
# the refused module scripts come back as `net::ERR_FAILED`, the graph never
# finishes, and the app is stuck on its boot screen forever — the same screen a
# genuine start-up failure shows.
#
# Measured on this edge: `keepalive_requests 50` makes the workbench specs fail
# that way even one file at a time, and the built-in 1000 makes them fail only
# once enough earlier traffic has pushed a page load across the boundary — which
# is exactly why the failure looked like an undeterministic flake with a
# different victim each run, rather than a broken spec.
#
# A local dev edge serves one browser on a trusted host, so the resource
# argument the default protects against does not apply here; the number only
# has to sit far above any single page's module count.
keepalive_requests 100000;

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name proflow.local api.proflow.local;

    return 301 https://$host$request_uri;
}

# App shell (Next dev on host)
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name proflow.local;

    ssl_certificate     /etc/nginx/ssl/proflow.local.crt;
    ssl_certificate_key /etc/nginx/ssl/proflow.local.key;

    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Same-origin backend API: the workbench reaches REST, Realtime and Storage
    # under this prefix, so none of its requests crosses origins and none needs a
    # CORS preflight (the preflight cache is keyed by full URL, and every pull URL
    # carries a new cursor, so cross-origin it never hit). The prefix is stripped
    # (trailing slash on proxy_pass) before the gateway sees the request; the
    # api.proflow.local block below stays for server-side callers, tools and
    # uploads. nginx picks the longest matching prefix, so this wins over `/`.
    location @BACKEND_PATH@/ {
        client_max_body_size 5g;
        proxy_request_buffering off;
        proxy_pass http://@SUPABASE_UPSTREAM_HOST@:@SUPABASE_UPSTREAM_PORT@/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        # Realtime is a WebSocket: without the upgrade headers the channel never
        # subscribes and replication silently falls back to its slowest cadence.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Same origin: the gateway's permissive CORS headers are noise here.
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
    }

    location / {
        # Static proxy_pass (not a variable): nginx resolves host.docker.internal at
        # startup via /etc/hosts, where Docker's host-gateway entry lives on native Linux.
        # The variable form would force the resolver (Docker DNS 127.0.0.11), which returns
        # NXDOMAIN for host.docker.internal on Linux → 502. Matches the Supabase upstream below.
        proxy_pass http://host.docker.internal:@PROFLOW_DEV_APP_PORT@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

# Self-hosted Supabase API (Kong upstream from env). Use NEXT_PUBLIC_SUPABASE_URL=https://api.proflow.local
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name api.proflow.local;

    ssl_certificate     /etc/nginx/ssl/proflow.local.crt;
    ssl_certificate_key /etc/nginx/ssl/proflow.local.key;

    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_protocols TLSv1.2 TLSv1.3;

    # KB media large uploads: the edge must allow a
    # request body up to the 5 GiB HARD cap, else nginx's DEFAULT 1 MB limit 413s the
    # resumable (TUS) POST/PATCH before it reaches Kong→storage-api. Resumable chunks
    # are ~6 MiB, but creation-with-upload can carry a whole small-but->1 MB file in
    # one POST — so cap at the system max, not the chunk size. Stream, don't buffer the
    # body to disk, so multi-GB uploads don't fill the proxy.
    client_max_body_size 5g;
    proxy_request_buffering off;

    location / {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin $supabase_cors_origin;
            add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS";
            # The tus-resumable (TUS) headers are load-bearing for BROWSER uploads: a
            # PATCH chunk sends `upload-offset`, so it MUST be in the allow-list or the
            # browser blocks every chunk on preflight (the creation POST — which sends
            # only upload-length/upload-metadata — would still 201, so the symptom is
            # "create OK, chunks CORS-error, upload never finishes"). Node (e2e) skips
            # CORS, which is why this only bites the real browser client.
            #
            # accept-profile / content-profile are the same class of bug one layer up:
            # postgrest-js sends `accept-profile` on every READ and `content-profile` on
            # every WRITE whenever a schema is configured, so a browser client talking to
            # /rest/v1 is blocked on preflight before a single row moves. Measured on the
            # SPA's graph replication: the setting arrived, the client was built, the GET
            # left the page, and Chrome refused it with "Request header field
            # accept-profile is not allowed by Access-Control-Allow-Headers". Node (e2e)
            # again skips CORS, so only the real browser sees it.
            add_header Access-Control-Allow-Headers "Authorization, Content-Type, apikey, X-Client-Info, X-Supabase-Api-Version, Accept, Accept-Profile, Content-Profile, Prefer, Range, x-upsert, tus-resumable, upload-length, upload-offset, upload-metadata, upload-concat, upload-defer-length, x-http-method-override, cache-control";
            add_header Access-Control-Allow-Credentials true;
            add_header Access-Control-Max-Age 86400;
            return 204;
        }

        proxy_pass http://@SUPABASE_UPSTREAM_HOST@:@SUPABASE_UPSTREAM_PORT@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Kong emits permissive CORS headers (`*`) which conflict with credentialed browser requests.
        # Normalize CORS at nginx edge to a single origin value.
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;

        add_header Access-Control-Allow-Origin $supabase_cors_origin always;
        add_header Access-Control-Allow-Credentials true always;
        # tus-js-client reads these off the POST/PATCH/HEAD responses (the upload
        # `Location`, the resumed `Upload-Offset`, …). Cross-origin JS can only see
        # them when they are explicitly exposed; add it at the edge so the browser
        # TUS client works regardless of the upstream's own CORS emission.
        add_header Access-Control-Expose-Headers "Location, Tus-Resumable, Tus-Version, Tus-Extension, Tus-Max-Size, Upload-Offset, Upload-Length, Upload-Metadata, Upload-Expires, Content-Type" always;
    }
}
