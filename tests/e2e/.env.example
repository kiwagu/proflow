PLAYWRIGHT_BASE_URL=https://proflow.local
NEXT_PUBLIC_SUPABASE_URL=https://api.proflow.local
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
STAGEHAND_ENV=LOCAL
OPENAI_API_KEY=

# Avatar/storage smoke uses the same NEXT_PUBLIC_SUPABASE_URL and seeded-user auth.
# No extra storage-specific env vars are required for `user can upload avatar`.

# Optional (full suite): assert Supabase→Author identity sync via Payload MongoDB (same as apps/author MONGO_URL).
# E2E_AUTHOR_MONGO_URL=mongodb://mongo_user:...@127.0.0.1:27017/payload?authSource=admin

# Optional (full suite): notifications-service + Maildev endpoints used by outbox delivery tests.
# Defaults if omitted: http://127.0.0.1:3010 and http://127.0.0.1:9090
# E2E_NOTIFICATIONS_URL=http://127.0.0.1:3010
# E2E_NOTIFICATIONS_INTERNAL_TOKEN=dev-notifications-token
# E2E_MAILDEV_URL=http://127.0.0.1:9090

# Platform @smoke space-invite UI: same Supabase as above with migrations for organizations + space_invites.
# Full notifications/outbox tests require running services/notifications with SMTP pointed at Maildev.
