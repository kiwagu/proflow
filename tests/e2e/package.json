{
  "name": "@workspace/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "bunx eslint .",
    "lint:strict": "bunx eslint . --max-warnings 0",
    "format": "bunx prettier --write \"src/**/*.ts\" \"*.{json,md,ts}\"",
    "typecheck": "tsc --noEmit",
    "test:e2e": "cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:e2e:smoke": "cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts --grep @smoke",
    "test:e2e:smoke:ni": "cross-env CI=1 NODE_OPTIONS=\"--use-system-ca --no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts --grep @smoke --reporter=line",
    "test:e2e:full": "cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:e2e:full:ni": "cross-env CI=1 NODE_OPTIONS=\"--use-system-ca --no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts --reporter=line -x",
    "test:e2e:headed": "cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts --headed",
    "open-browser": "cross-env NODE_OPTIONS=\"--no-deprecation\" tsx src/open-browser.ts",
    "stagehand:smoke": "cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation --import=tsx/esm\" tsx src/stagehand.chat.ts",
    "test:e2e:db-sweep": "cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation --import=tsx/esm\" tsx src/helpers/e2e-artifact-sweep.ts"
  },
  "devDependencies": {
    "@browserbasehq/stagehand": "^3.5.0",
    "@playwright/test": "catalog:",
    "@supabase/ssr": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "@workspace/db": "workspace:*",
    "@workspace/knowledge-contracts": "workspace:*",
    "@workspace/knowledge-engine": "workspace:*",
    "@workspace/rbac": "workspace:*",
    "@workspace/seed": "workspace:*",
    "@workspace/settings-runtime": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@types/pg": "catalog:",
    "cross-env": "catalog:",
    "dotenv": "catalog:",
    "mongodb": "^7.3.0",
    "pg": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
