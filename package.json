{
  "name": "proflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "bun run ./scripts/build-capped.ts",
    "refactor:scan": "bun run ./scripts/find-refactor-candidates.ts",
    "build:libs": "turbo run build --filter=\"./packages/*\"",
    "db:types": "make db-types",
    "db:types:check": "make db-types && git diff --exit-code -- packages/db/src/database.types.ts",
    "dev:apps": "bun run ./scripts/turbo-with-exclude.ts dev",
    "dev": "bun run build:libs && bun run dev:apps",
    "dev:browser": "bun run --cwd tests/e2e open-browser",
    "lint": "turbo lint",
    "lint:strict": "turbo lint:strict",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "bun run test:vitest",
    "test:e2e:headed": "turbo test:e2e:headed --filter=@workspace/e2e",
    "test:e2e:smoke": "turbo test:e2e:smoke --filter=@workspace/e2e",
    "test:e2e:smoke:ni": "CI=1 turbo test:e2e:smoke:ni --filter=@workspace/e2e",
    "test:e2e:full": "turbo test:e2e:full --filter=@workspace/e2e",
    "test:e2e:full:ni": "CI=1 turbo test:e2e:full:ni --filter=@workspace/e2e",
    "test:e2e": "turbo test:e2e --filter=@workspace/e2e",
    "seed": "bun run --cwd seed start --",
    "seed:list": "bun run --cwd seed start -- --list",
    "test:vitest": "CI=1 turbo run test:vitest",
    "test:full:ni": "bun run test:vitest && bun run test:e2e:full:ni",
    "check": "bun run db:types && bun run format && bun run lint && bun run typecheck",
    "notifications:bundle": "bun run --cwd packages/notifications build:deno",
    "postinstall": "husky",
    "prepare": "husky"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "husky": "^9.1.7",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.10.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.3.11"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "services/*",
      "tests/*",
      "seed"
    ],
    "catalog": {
      "@ai-sdk/anthropic": "^4.0.41",
      "@ai-sdk/provider": "^4.0.7",
      "@electric-sql/pglite": "^0.5.5",
      "@electric-sql/pglite-pgvector": "^0.0.6",
      "@huggingface/transformers": "^4.2.0",
      "@jitl/quickjs-singlefile-browser-release-sync": "^0.31.0",
      "@lexical/clipboard": "0.45.0",
      "@lexical/code": "0.45.0",
      "@lexical/headless": "0.45.0",
      "@lexical/history": "0.45.0",
      "@lexical/html": "0.45.0",
      "@lexical/link": "0.45.0",
      "@lexical/list": "0.45.0",
      "@lexical/mark": "0.45.0",
      "@lexical/markdown": "0.45.0",
      "@lexical/plain-text": "0.45.0",
      "@lexical/rich-text": "0.45.0",
      "@lexical/selection": "0.45.0",
      "@lexical/table": "0.45.0",
      "@lexical/utils": "0.45.0",
      "@floating-ui/dom": "^1.7.4",
      "@leeoniya/ufuzzy": "^1.0.19",
      "@playwright/test": "1.61.0-alpha-2026-06-12",
      "@supabase/ssr": "^0.12.0",
      "@supabase/supabase-js": "^2.110.0",
      "@tailwindcss/postcss": "^4.3.2",
      "@testing-library/react": "^16.3.2",
      "@types/node": "^25.9.4",
      "@types/katex": "^0.16.7",
      "@types/linkify-it": "^5.0.0",
      "@types/pg": "^8.20.0",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "@zip.js/zip.js": "^2.8.57",
      "ai": "^7.0.77",
      "cross-env": "^10.1.0",
      "dotenv": "^17.4.2",
      "eslint": "^10.5.0",
      "eslint-config-next": "16.2.10",
      "hash-wasm": "^4.12.0",
      "emojibase-data": "^17.0.0",
      "emojilib": "^4.0.2",
      "fast-deep-equal": "^3.1.3",
      "jsdom": "^28.1.0",
      "katex": "^0.16.22",
      "linkify-it": "^5.0.0",
      "virtua": "0.48.8",
      "unicode-emoji-json": "^0.8.0",
      "loro-crdt": "^1.14.1",
      "bitf": "^1.0.2",
      "diff": "^9.0.0",
      "fast-xml-parser": "^4.5.6",
      "flat": "^6.0.1",
      "lexical": "0.45.0",
      "lucide-react": "^1.18.0",
      "nanoid": "^6.0.1",
      "neverthrow": "^8.2.0",
      "next": "16.2.10",
      "next-themes": "^0.4.6",
      "pg": "^8.22.0",
      "prettier": "^3.9.5",
      "quickjs-emscripten-core": "^0.31.0",
      "random-js": "^2.1.0",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "shadcn": "^4.13.0",
      "tailwindcss": "^4.3.2",
      "tsx": "^4.23.0",
      "ts-pattern": "^5.9.0",
      "tw-animate-css": "^1.4.0",
      "typescript": "^6.0.3",
      "vitest": "^4.1.10",
      "zod": "^4.4.3"
    },
    "catalogs": {
      "payload": {
        "payload": "3.86.0",
        "@payloadcms/db-mongodb": "3.86.0",
        "@payloadcms/next": "3.86.0",
        "@payloadcms/plugin-multi-tenant": "3.86.0",
        "@payloadcms/richtext-lexical": "3.86.0",
        "@payloadcms/storage-s3": "3.86.0",
        "@payloadcms/translations": "3.86.0",
        "@payloadcms/ui": "3.86.0"
      }
    }
  },
  "dependencies": {
    "supabase": "^2.109.1"
  },
  "patchedDependencies": {
    "@lexical/markdown@0.45.0": "patches/@lexical%2Fmarkdown@0.45.0.patch",
    "@lexical/table@0.45.0": "patches/@lexical%2Ftable@0.45.0.patch"
  }
}
