{
  "name": "proflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "bun run ./scripts/build-capped.ts",
    "build:libs": "turbo run build --filter=\"./packages/*\"",
    "db:types": "make db-types",
    "db:types:check": "make db-types && git diff --exit-code -- packages/db/src/database.types.ts",
    "dev:apps": "bun run ./scripts/turbo-with-exclude.ts dev",
    "dev": "bun run build:libs && bun run dev:apps",
    "dev:browser": "bun run --cwd tests/e2e open-browser",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test:e2e:headed": "turbo test:e2e:headed --filter=@workspace/e2e",
    "test:e2e:smoke": "turbo test:e2e:smoke --filter=@workspace/e2e",
    "test:e2e:smoke:ni": "CI=1 turbo test:e2e:smoke:ni --filter=@workspace/e2e",
    "test:e2e:full": "turbo test:e2e:full --filter=@workspace/e2e",
    "test:e2e:full:ni": "CI=1 turbo test:e2e:full:ni --filter=@workspace/e2e",
    "test:e2e": "turbo test:e2e --filter=@workspace/e2e",
    "test:vitest": "CI=1 turbo run test:vitest",
    "test:full:ni": "bun run test:vitest && bun run test:e2e:full:ni",
    "check": "bun run db:types && bun run format && bun run lint && bun run typecheck",
    "notifications:bundle": "bun run --cwd packages/notifications build:deno",
    "postinstall": "husky",
    "prepare": "husky"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "husky": "^9.1.7",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.10.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.3.11"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "services/*",
      "tests/*"
    ],
    "catalog": {
      "@playwright/test": "1.61.0-alpha-2026-06-12",
      "@supabase/ssr": "^0.12.0",
      "@supabase/supabase-js": "^2.110.0",
      "@tailwindcss/postcss": "^4.3.2",
      "@types/node": "^25.9.4",
      "@types/pg": "^8.20.0",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "cross-env": "^10.1.0",
      "dotenv": "^17.4.2",
      "eslint": "^10.6.0",
      "eslint-config-next": "16.2.10",
      "lucide-react": "^1.23.0",
      "next": "16.2.10",
      "next-themes": "^0.4.6",
      "pg": "^8.22.0",
      "prettier": "^3.9.4",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "shadcn": "^4.13.0",
      "tailwindcss": "^4.3.2",
      "tsx": "^4.23.0",
      "tw-animate-css": "^1.4.0",
      "typescript": "^6.0.3",
      "vitest": "^4.1.10",
      "zod": "^4.4.3"
    },
    "catalogs": {
      "payload": {
        "payload": "3.85.2",
        "@payloadcms/db-mongodb": "3.85.2",
        "@payloadcms/next": "3.85.2",
        "@payloadcms/plugin-multi-tenant": "3.85.2",
        "@payloadcms/richtext-lexical": "3.85.2",
        "@payloadcms/storage-s3": "3.85.2",
        "@payloadcms/translations": "3.85.2",
        "@payloadcms/ui": "3.85.2"
      }
    }
  },
  "dependencies": {
    "supabase": "^2.109.0"
  }
}
