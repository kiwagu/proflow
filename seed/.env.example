# Seed env — the seed reuses the same Supabase wiring as the e2e harness.
# If tests/e2e/.env already has these, the CLI loads them automatically and you
# can leave this file unset. Shell env always wins over both .env files.

# Author app base URL whose /author/graph/* endpoints the seed drives.
SEED_BASE_URL=https://proflow.local

# Supabase (service-role provisions tenants; anon signs actors in).
NEXT_PUBLIC_SUPABASE_URL=https://api.proflow.local
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Set to 1 to disable TLS verification for non-.local hosts (dev/demo only).
# SEED_INSECURE_TLS=1

