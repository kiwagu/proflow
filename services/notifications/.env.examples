# notifications-service (examples)
#
# Copy to `.env` and adjust values.
# The service reads these via `process.env`.

# HTTP server
HOST=0.0.0.0
PORT=3010

# Internal auth (required for POST /v1/notifications/email)
NOTIFICATIONS_INTERNAL_TOKEN=dev-notifications-token
# Optional override for GoTrue hook rendering route in app.
# For apps/platform default Next basePath use /platform/auth/confirm.
AUTH_EMAIL_CONFIRM_PATH=/platform/auth/confirm

# SMTP transport (required)
SMTP_HOST=127.0.0.1
SMTP_PORT=2500
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Proflow <noreply@local.test>"

# Alternative (if SMTP_FROM is not set, the library falls back to SMTP_ADMIN_EMAIL)
SMTP_ADMIN_EMAIL=noreply@local.test

# Supabase service role access (required for universal outbox worker / GoTrue enqueue)
SUPABASE_URL=https://api.proflow.local
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Default locale for templated email (en|de); shared by all templates in this process
# NOTIFICATIONS_DEFAULT_LOCALE=en

# Universal outbox worker
# NOTIFICATIONS_OUTBOX_CONSUMER=notifications-service
# NOTIFICATIONS_OUTBOX_BATCH_SIZE=10
# NOTIFICATIONS_OUTBOX_POLL_INTERVAL_MS=1000
# NOTIFICATIONS_OUTBOX_RETRY_SECONDS=60

# Invite link rendering (required for outbox-delivered space invites).
GATEWAY_ENTRY_ORIGIN=https://proflow.local
# Same value as apps/platform + gateway-auth (`NEXT_PUBLIC_GATEWAY_PLATFORM_PATH`, default /platform).
NEXT_PUBLIC_GATEWAY_PLATFORM_PATH=/platform
