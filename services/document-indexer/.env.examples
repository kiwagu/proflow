# document-indexer service (examples)
#
# Copy to `.env` and adjust values.
# Read via `process.env` (bun --env-file=.env).

# Supabase service-role access (required — the trusted background channel;
# the derive worker is the only writer of the server search index)
SUPABASE_URL=https://api.proflow.local
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Optional tuning
# Documents derived per pass before the loop sleeps (default 25).
# DOCUMENT_INDEXER_BATCH_SIZE=25
# Sleep between passes when the index is up to date, in ms (default 15000).
# DOCUMENT_INDEXER_POLL_INTERVAL_MS=15000
