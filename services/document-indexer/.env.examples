# document-indexer service (examples)
#
# Copy to `.env` and adjust values.
# Read via `process.env` (tsx --env-file-if-exists=.env).

# Supabase service-role access (required — the trusted background channel;
# the derive worker is the only writer of the server search index)
SUPABASE_URL=https://api.proflow.local
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Anon key (optional) — enables the search endpoint. Every query runs under
# the CALLER's bearer token, so RLS is the fence; without this the process is
# a pure background worker.
SUPABASE_ANON_KEY=replace-me

# Optional tuning
# Documents derived per pass before the loop sleeps (default 25).
# DOCUMENT_INDEXER_BATCH_SIZE=25
# Sleep between passes when the index is up to date, in ms (default 15000).
# DOCUMENT_INDEXER_POLL_INTERVAL_MS=15000
# Search endpoint port (default 3020) and bind host (default 0.0.0.0).
# DOCUMENT_INDEXER_SEARCH_PORT=3020
# HOST=0.0.0.0
