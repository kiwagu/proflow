# knowledge-workers service (examples)
#
# Copy to `.env` and adjust values.
# Both workers read these via `process.env` (bun --env-file=.env).

# Supabase service-role access (required by both workers — the trusted
# background channel; never exposed to any request surface)
SUPABASE_URL=https://api.proflow.local
SUPABASE_SERVICE_ROLE_KEY=replace-me

# JetStream broker (required by the knowledge-activity worker only)
NATS_URL=nats://127.0.0.1:4222

# Optional stream/consumer overrides (defaults come from the shared contract)
# KNOWLEDGE_ACTIVITY_NATS_STREAM=KNOWLEDGE_ACTIVITY
# KNOWLEDGE_ACTIVITY_NATS_CONSUMER=author-activity-v1
