{
  "name": "@workspace/knowledge-workers-service",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -n activity,mediareap -c cyan,yellow \"bun --env-file=.env --watch src/knowledge-activity.worker.ts\" \"bun --env-file=.env --watch src/kb-media-reconcile.worker.ts\"",
    "start:knowledge-activity": "bun --env-file=.env src/knowledge-activity.worker.ts",
    "start:kb-media-reconcile": "bun --env-file=.env src/kb-media-reconcile.worker.ts",
    "kb-media-reconcile:once": "bun --env-file=.env src/kb-media-reconcile.worker.ts --once",
    "build": "tsc",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0",
    "format": "bunx prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "bunx vitest run",
    "test:vitest": "bunx vitest run"
  },
  "dependencies": {
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "@supabase/supabase-js": "catalog:",
    "@workspace/db": "workspace:*",
    "@workspace/knowledge-contracts": "workspace:*",
    "concurrently": "^10.0.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "catalog:",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:^",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
