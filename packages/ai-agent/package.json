{
  "name": "@workspace/ai-agent",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0",
    "format": "bunx prettier --write .",
    "typecheck": "tsc --noEmit",
    "test:vitest": "bunx vitest run",
    "test": "bunx vitest run"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "dependencies": {
    "@ai-sdk/anthropic": "catalog:",
    "@ai-sdk/provider": "catalog:",
    "@jitl/quickjs-singlefile-browser-release-sync": "catalog:",
    "@workspace/ai-ops": "workspace:*",
    "@workspace/domain": "workspace:*",
    "@workspace/lexical-nodes": "workspace:*",
    "ai": "catalog:",
    "lexical": "catalog:",
    "nanoid": "catalog:",
    "neverthrow": "catalog:",
    "quickjs-emscripten-core": "catalog:",
    "ts-pattern": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/ai-local": "workspace:*",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:^",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
