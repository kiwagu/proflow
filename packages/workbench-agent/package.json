{
  "name": "@workspace/workbench-agent",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "sideEffects": [
    "./src/worker/prism-guard.ts",
    "./src/worker/agent.worker.ts"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0",
    "format": "bunx prettier --write .",
    "typecheck": "tsc --noEmit",
    "test:vitest": "bunx vitest run",
    "test": "bunx vitest run"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./worker": {
      "types": "./src/worker/agent.worker.ts",
      "import": "./src/worker/agent.worker.ts",
      "default": "./src/worker/agent.worker.ts"
    }
  },
  "dependencies": {
    "@workspace/ai-agent": "workspace:*",
    "@workspace/ai-local": "workspace:*",
    "@workspace/domain": "workspace:*",
    "@workspace/embedding": "workspace:*",
    "@workspace/persistence-pglite": "workspace:*",
    "lexical": "catalog:",
    "neverthrow": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "devDependencies": {
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:^",
    "ai": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
