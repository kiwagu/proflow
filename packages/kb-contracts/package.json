{
  "name": "@workspace/kb-contracts",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "format": "bunx prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "bunx vitest run",
    "test:vitest": "bunx vitest run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:^",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./resource-description": {
      "types": "./dist/resource-description.schema.d.ts",
      "import": "./dist/resource-description.schema.js"
    },
    "./resource-provenance": {
      "types": "./dist/resource-provenance.schema.d.ts",
      "import": "./dist/resource-provenance.schema.js"
    },
    "./resource-activity": {
      "types": "./dist/resource-activity.schema.d.ts",
      "import": "./dist/resource-activity.schema.js"
    },
    "./resource-link": {
      "types": "./dist/resource-link.schema.d.ts",
      "import": "./dist/resource-link.schema.js"
    },
    "./resource-media-meta": {
      "types": "./dist/resource-media-meta.schema.d.ts",
      "import": "./dist/resource-media-meta.schema.js"
    },
    "./resource-embedding": {
      "types": "./dist/resource-embedding.schema.d.ts",
      "import": "./dist/resource-embedding.schema.js"
    }
  }
}
