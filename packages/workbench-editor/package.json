{
  "name": "@workspace/workbench-editor",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0",
    "format": "bunx prettier --write .",
    "typecheck": "tsc --noEmit",
    "test:vitest": "bunx vitest run",
    "test": "bunx vitest run"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "@lexical/history": "catalog:",
    "@lexical/link": "catalog:",
    "@lexical/mark": "catalog:",
    "@lexical/rich-text": "catalog:",
    "@lexical/table": "catalog:",
    "@lexical/utils": "catalog:",
    "@workspace/domain": "workspace:*",
    "@workspace/i18n-catalogs": "workspace:*",
    "@workspace/lexical-nodes": "workspace:*",
    "@workspace/lexical-react": "workspace:*",
    "@workspace/ui": "workspace:*",
    "lexical": "catalog:",
    "lucide-react": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@lexical/headless": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:^",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
