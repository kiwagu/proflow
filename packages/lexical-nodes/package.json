{
  "name": "@workspace/lexical-nodes",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./transformers": {
      "types": "./src/transformers/index.ts",
      "import": "./src/transformers/index.ts",
      "default": "./src/transformers/index.ts"
    },
    "./transformers/xml": {
      "types": "./src/transformers/xml/index.ts",
      "import": "./src/transformers/xml/index.ts",
      "default": "./src/transformers/xml/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "import": "./src/utils/index.ts",
      "default": "./src/utils/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:vitest": "bunx vitest run",
    "test": "bunx vitest run"
  },
  "dependencies": {
    "@lexical/code": "catalog:",
    "@lexical/headless": "catalog:",
    "@lexical/link": "catalog:",
    "@lexical/list": "catalog:",
    "@lexical/mark": "catalog:",
    "@lexical/markdown": "catalog:",
    "@lexical/rich-text": "catalog:",
    "@lexical/table": "catalog:",
    "@lexical/utils": "catalog:",
    "bitf": "catalog:",
    "diff": "catalog:",
    "fast-xml-parser": "catalog:",
    "flat": "catalog:",
    "lexical": "catalog:",
    "nanoid": "catalog:",
    "prismjs": "^1.30.0",
    "ts-pattern": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:^",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
