{
  "name": "@workspace/ai-ops",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0",
    "format": "bunx prettier --write .",
    "typecheck": "tsc --noEmit",
    "test:vitest": "bunx vitest run",
    "test": "bunx vitest run"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./utils": {
      "types": "./src/utils.ts",
      "import": "./src/utils.ts",
      "default": "./src/utils.ts"
    },
    "./*": {
      "types": "./src/*/index.ts",
      "import": "./src/*/index.ts",
      "default": "./src/*/index.ts"
    }
  },
  "dependencies": {
    "@lexical/code": "catalog:",
    "@lexical/link": "catalog:",
    "@lexical/list": "catalog:",
    "@lexical/mark": "catalog:",
    "@lexical/markdown": "catalog:",
    "@lexical/rich-text": "catalog:",
    "@lexical/table": "catalog:",
    "@workspace/lexical-nodes": "workspace:*",
    "lexical": "catalog:",
    "random-js": "catalog:",
    "ts-pattern": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:^",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
