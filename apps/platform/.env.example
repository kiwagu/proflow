# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
# Local dev: use https://api.proflow.local (nginx → Kong :8000) — add api.proflow.local to /etc/hosts; see infra/dev/nginx/README.md.
NEXT_PUBLIC_SUPABASE_URL=https://api.proflow.local
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Storage / avatar MVP uses the same public Supabase API origin and publishable key.
# No extra storage-specific env vars are required for profile avatar uploads.

# Next `basePath` for this app (must match gateway + nginx). Overrides default /platform.
NEXT_PUBLIC_APP_BASE_PATH=/platform
NEXT_PUBLIC_GATEWAY_PLATFORM_PATH=/platform

# Browser-facing origin when this app is proxied (nginx gateway).
# Same as apps/web `GATEWAY_ENTRY_ORIGIN` if you use turbo/global env; set explicitly if needed.
NEXT_PUBLIC_GATEWAY_ORIGIN=https://proflow.local

# Dev: `true` restores full Next.js incoming request logs (GET/HEAD/RSC). Default: mutating-only logs via proxy.
# DEV_FULL_REQUEST_LOG=true

# Invite bootstrap: create Auth user + magic link (server-only; never expose to browser).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# One-time sealed bootstrap of the first platform super admin.
# When this email signs in and there are no active platform super-admin grants yet,
# the server seals the bootstrap flow and grants `platform.admin.override` once.
PLATFORM_INITIAL_SUPER_ADMIN_EMAIL=

# Outbound email: SMTP and templates live in @workspace/notifications; the Bun process services/notifications runs HTTP + the outbox worker and uses that package.
# Root `bun run dev` (turbo) starts that service with the rest of the stack; from apps/platform only: `bun run dev` is Next-only — use root dev or `bun run --cwd services/notifications dev` when you need mail locally without turbo.
# Configure Supabase service-role access + SMTP on the service (see services/notifications/.env.examples).
