{
  "name": "author",
  "version": "0.1.0",
  "description": "Author app built on Payload CMS 3.83.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prebuild": "bun run generate:importmap",
    "predev": "bun run generate:importmap",
    "predev:next": "bun run generate:importmap",
    "predevsafe": "bun run generate:importmap",
    "build": "cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation --max-old-space-size=8000\" next build",
    "dev": "concurrently -s command-next -n next,jetstream,spaceorg -c blue,magenta,green \"cross-env NODE_OPTIONS=\\\"--use-system-ca --no-deprecation\\\" next dev --hostname 0.0.0.0 -p 3002\" \"cross-env NODE_OPTIONS=\\\"--use-system-ca --no-deprecation\\\" bun ./src/identity/identity.jetstream.worker.ts\" \"cross-env NODE_OPTIONS=\\\"--use-system-ca --no-deprecation\\\" bun ./src/identity/space-org.jetstream.worker.ts\"",
    "dev:next": "cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation\" next dev --hostname 0.0.0.0 -p 3002",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation\" next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation\" payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation\" payload generate:types",
    "lint": "cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation\" eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\" \"!**/.next/**\"",
    "typecheck": "tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation\" payload",
    "start": "cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation\" next start",
    "identity:jetstream": "cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation\" bun ./src/identity/identity.jetstream.worker.ts",
    "space-org:jetstream": "cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation\" bun ./src/identity/space-org.jetstream.worker.ts",
    "test:vitest": "cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation\" vitest run --config ./vitest.config.mts",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation\" vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1033.0",
    "@eslint/eslintrc": "^3.3.5",
    "@nats-io/jetstream": "3.3.1",
    "@nats-io/transport-node": "3.3.1",
    "@payloadcms/db-mongodb": "3.83.0",
    "@payloadcms/next": "3.83.0",
    "@payloadcms/plugin-multi-tenant": "3.83.0",
    "@payloadcms/richtext-lexical": "3.83.0",
    "@payloadcms/storage-s3": "3.83.0",
    "@payloadcms/translations": "3.83.0",
    "@payloadcms/ui": "3.83.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.100.0",
    "@workspace/db": "workspace:*",
    "@workspace/domain-events": "workspace:*",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/gateway-auth": "workspace:*",
    "@workspace/i18n-catalogs": "workspace:*",
    "@workspace/payload-plugins": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/ui": "workspace:*",
    "cross-env": "^10.1.0",
    "dotenv": "17.3.1",
    "graphql": "^16.13.1",
    "jose": "^6.2.2",
    "next": "16.2.3",
    "payload": "3.83.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "sharp": "0.34.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.1.0",
    "eslint-config-next": "16.2.3",
    "jsdom": "29.0.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "tsx": "4.21.0",
    "typescript": "6.0.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.1"
  }
}