{
  "name": "author",
  "version": "0.1.0",
  "description": "Author app built on Payload CMS 3.85.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prebuild": "bun run generate:importmap",
    "predev": "bun run generate:importmap",
    "predev:next": "bun run generate:importmap",
    "predevsafe": "bun run generate:importmap",
    "build": "cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation --max-old-space-size=8000\" next build",
    "dev": "concurrently -s command-next -n next,jetstream,spaceorg,activity,mediareap -c blue,magenta,green,cyan,yellow \"cross-env NODE_OPTIONS=\\\"--use-system-ca --no-deprecation\\\" next dev --hostname 0.0.0.0 -p 3002\" \"cross-env NODE_OPTIONS=\\\"--use-system-ca --no-deprecation\\\" tsx ./src/identity/identity.jetstream.worker.ts\" \"cross-env NODE_OPTIONS=\\\"--use-system-ca --no-deprecation\\\" tsx ./src/identity/space-org.jetstream.worker.ts\" \"cross-env NODE_OPTIONS=\\\"--use-system-ca --no-deprecation\\\" tsx ./src/knowledge/knowledge-activity.jetstream.worker.ts\" \"cross-env NODE_OPTIONS=\\\"--use-system-ca --no-deprecation\\\" tsx ./src/knowledge/kb-media-reconcile.worker.ts\"",
    "dev:next": "cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation\" next dev --hostname 0.0.0.0 -p 3002",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation\" next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation\" payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation\" payload generate:types",
    "lint": "cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation\" eslint .",
    "lint:strict": "cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation\" eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx}\" \"!**/.next/**\"",
    "typecheck": "tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation\" payload",
    "start": "cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation\" next start",
    "identity:jetstream": "cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation\" tsx ./src/identity/identity.jetstream.worker.ts",
    "space-org:jetstream": "cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation\" tsx ./src/identity/space-org.jetstream.worker.ts",
    "knowledge-activity:jetstream": "cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation\" tsx ./src/knowledge/knowledge-activity.jetstream.worker.ts",
    "kb-media-reconcile:worker": "cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation\" tsx ./src/knowledge/kb-media-reconcile.worker.ts",
    "test:vitest": "cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation\" vitest run --config ./vitest.config.mts",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=\"--use-system-ca --no-deprecation\" vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "@dnd-kit/core": "6.3.1",
    "@eslint/eslintrc": "^3.3.5",
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "@payloadcms/db-mongodb": "catalog:payload",
    "@payloadcms/next": "catalog:payload",
    "@payloadcms/plugin-multi-tenant": "catalog:payload",
    "@payloadcms/richtext-lexical": "catalog:payload",
    "@payloadcms/storage-s3": "catalog:payload",
    "@payloadcms/translations": "catalog:payload",
    "@payloadcms/ui": "catalog:payload",
    "@supabase/ssr": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "@workspace/db": "workspace:*",
    "@workspace/domain-events": "workspace:*",
    "@workspace/entity-id": "workspace:*",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/gateway-auth": "workspace:*",
    "@workspace/i18n-catalogs": "workspace:*",
    "@workspace/knowledge-contracts": "workspace:*",
    "@workspace/knowledge-engine": "workspace:*",
    "@workspace/payload-plugins": "workspace:*",
    "@workspace/settings-runtime": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/ui": "workspace:*",
    "cross-env": "catalog:",
    "diff": "^9.0.0",
    "dotenv": "catalog:",
    "graphql": "^16.14.2",
    "jose": "^6.2.3",
    "next": "catalog:",
    "payload": "catalog:payload",
    "pg": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "catalog:",
    "sharp": "0.35.3",
    "tus-js-client": "^4.3.1",
    "tw-animate-css": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/react": "16.3.2",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "^10.0.3",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "jsdom": "29.1.1",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "catalog:"
  }
}
