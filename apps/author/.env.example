MONGO_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used by apps/author/docker-compose.yml when running Mongo from this package (optional if you use infra/dev mongo only).
MONGO_PASSWORD=your-mongo-password

# Supabase — same env names as apps/platform (publishable / anon JWT from infra dev stack)
NEXT_PUBLIC_SUPABASE_URL=https://api.proflow.local
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_SECRET=
# Server-side fallback sync (space/org worker): required to read auth.users/profiles.
SUPABASE_SERVICE_ROLE_KEY=

# Projection-resolve transport (ADR-0009): direct (session-mode) Postgres connection
# the author server uses to run TS-compiled projection SELECTs server-side under the
# user's RLS. Connect as the dedicated `projection_resolver` role (non-owner,
# non-bypass-RLS); the resolve downgrades to `authenticated` + the user's JWT claims
# inside one transaction. Use a DIRECT/session connection, NOT the pgbouncer
# transaction pooler (SET LOCAL must stay on one connection per resolve).
# PROJECTION_RESOLVER_DATABASE_URL=postgresql://projection_resolver:PASSWORD@127.0.0.1:54322/postgres

# Public browser origin (gateway). Required for correct client links if you omit it; server-side redirects still map :3002 → :3000 in development.
# Dev behind nginx gateway: https://proflow.local
NEXT_PUBLIC_GATEWAY_ORIGIN=https://proflow.local

# Next `basePath` / gateway author mount (must match apps/web + nginx). Defaults /author.
# NEXT_PUBLIC_APP_BASE_PATH=/author
# NEXT_PUBLIC_GATEWAY_AUTHOR_PATH=/author

# Dev: `true` restores full Next.js incoming request logs. Default: mutating-only logs via proxy.
# DEV_FULL_REQUEST_LOG=true

# Author media uploads use Payload's S3 storage adapter against Supabase Storage.
# Stored object keys are derived from the active space tenant as `spaces/<space_id>/author/...`.
# By default, Payload falls back to `${NEXT_PUBLIC_SUPABASE_URL}/storage/v1/s3` when S3_ENDPOINT is omitted.
# For local self-hosted Supabase, use the S3 protocol credentials from infra/dev/supabase/.env:
# S3_PROTOCOL_ACCESS_KEY_ID / S3_PROTOCOL_ACCESS_KEY_SECRET
# S3_ENDPOINT=https://api.proflow.local/storage/v1/s3
# S3_ACCESS_KEY_ID=your-s3-protocol-access-key-id
# S3_SECRET_ACCESS_KEY=your-s3-protocol-access-key-secret
# You can also use protocol names directly (supported by payload.config.ts):
# S3_PROTOCOL_ACCESS_KEY_ID=your-s3-protocol-access-key-id
# S3_PROTOCOL_ACCESS_KEY_SECRET=your-s3-protocol-access-key-secret
# S3_REGION=us-east-1

# JetStream consumer for identity lifecycle (Edge publishes to NATS; no HTTP subscriber).
# Match compose host port 4222 when using local Docker NATS:
# NATS_URL=nats://127.0.0.1:4222
# IDENTITY_NATS_STREAM=IDENTITY_LIFECYCLE
# IDENTITY_NATS_CONSUMER=author-identity-v1
# Knowledge-activity stream (ADR-0016): Bodies.afterChange publishes body-edit
# events; the activity consumer worker appends kb.resource_activity (service-role).
# Defaults live in code (@workspace/knowledge-contracts); env only OVERRIDES.
# KNOWLEDGE_ACTIVITY_NATS_STREAM=KNOWLEDGE_ACTIVITY
# KNOWLEDGE_ACTIVITY_NATS_CONSUMER=author-activity-v1
